menu "Motion"

config APP_MOTION
	bool "Motion detection module (ADXL367)"
	depends on ADXL367
	help
	  Enable the motion detection module. Uses the on-board ADXL367
	  low-power accelerometer to publish MOTION_ACTIVITY and
	  MOTION_INACTIVITY events on the motion_chan zbus channel.
	  Uses software polling — the ADXL367 hardware interrupt is not
	  used (known issue on Thingy:91 X, devzone.nordicsemi.com/f/nordic-q-a/126611).

config APP_MOTION_POLL_INTERVAL_MS
	int "Accelerometer poll interval (ms)"
	depends on APP_MOTION
	default 1000
	help
	  How often the ADXL367 is sampled for the software-based
	  activity/inactivity detection.

config APP_MOTION_INACTIVITY_SECONDS
	int "Inactivity duration before sleep (seconds)"
	depends on APP_MOTION
	default 180
	help
	  Number of consecutive seconds below the inactivity threshold
	  before MOTION_INACTIVITY is published. At the default 1 s poll
	  interval this equals the number of poll samples.

module = APP_MOTION
module-str = Motion
source "subsys/logging/Kconfig.template.log_config"

endmenu # Motion
