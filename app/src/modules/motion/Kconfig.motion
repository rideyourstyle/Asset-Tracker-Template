menu "Motion"

config APP_MOTION
	bool "Motion detection module (ADXL367)"
	depends on ADXL367
	help
	  Enable snapshot-based motion detection using the on-board ADXL367
	  low-power accelerometer. Called once per sampling cycle at the end
	  of each GNSS search (LOCATION_SEARCH_DONE). Compares consecutive
	  ACC snapshots — a stationary device reads near-zero delta regardless
	  of mounting angle.

module = APP_MOTION
module-str = Motion
source "subsys/logging/Kconfig.template.log_config"

endmenu # Motion
